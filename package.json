{
  "name": "agentchicago17b",
  "private": false,
  "version": "0.2.0",
  "description": "Open-source AI desk research agent that scopes questions, gathers sources, and synthesizes findings into research cards. Includes Eve durable runtime (Vercel Workflows + Sandbox).",
  "type": "module",
  "license": "MIT",
  "author": "AgentChicago17B Contributors",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "ai-agent",
    "desk-research",
    "research-agent",
    "open-source",
    "synthesis",
    "chicago",
    "eve",
    "vercel-sandbox",
    "vercel-workflows"
  ],
  "scripts": {
    "dev": "vite",
    "eve": "eve dev",
    "eve:build": "eve build",
    "eve:start": "eve start",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/run-regression.mjs",
    "chicago": "node packages/cli/bin/chicago.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:migrations": "wrangler d1 migrations apply agentchicago17b --local"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.1",
    "ai": "^7.0.52",
    "eve": "^0.30.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "daisyui": "^5.7.16",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.54.0"
  }
}
