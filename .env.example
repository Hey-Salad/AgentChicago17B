# --- Access wall (local SPA gate) ---
# Set a shared team code. Restart npm run dev after changes.
VITE_AUTH_REQUIRED=true
VITE_APP_ACCESS_CODE=

# Optional branding for OpenRouter rankings / Referer
VITE_APP_URL=http://127.0.0.1:5173
VITE_APP_NAME=AgentChicago17B

# Force provider when model slug is ambiguous: cloudflare | openrouter | nvidia
# VITE_LLM_PROVIDER=openrouter

# --- Cloudflare Workers AI (OpenAI-compatible) ---
# .../accounts/<ACCOUNT_ID>/ai/v1
VITE_CF_API_KEY=
VITE_CF_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Default model — CF GLM for commercial-grade reasoned briefs
VITE_LLM_MODEL=@cf/zai-org/glm-5.2

# --- OpenRouter (optional) ---
# https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Example defaults once OpenRouter is your primary provider:
# VITE_LLM_MODEL=anthropic/claude-sonnet-4
# VITE_LLM_PROVIDER=openrouter

# --- NVIDIA Build (optional second provider) ---
# https://build.nvidia.com/settings/api-keys
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional later: Tavily for live web source gathering
VITE_TAVILY_API_KEY=

# Optional: Cloudflare Whisper for mic → text (speech-to-text)
# Default: @cf/openai/whisper-large-v3-turbo
# VITE_CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
