# --- Access wall (local SPA gate) ---
# Auth adapter: access-code | cf-access | oauth | anonymous
# See docs/auth-modes.md · docs/product-map.md
VITE_AUTH_MODE=access-code
VITE_AUTH_REQUIRED=true
VITE_APP_ACCESS_CODE=

# Worker mirrors (production / wrangler)
# AUTH_MODE=access-code
# ACCESS_CODE=
# WORKSPACE_ID=ws_default
# WORKSPACE_NAME=AgentChicago17B

# --- Eve durable agent (Node runtime + sandbox) ---
# Run separately: npm run eve   (Node 24+ recommended)
# Default: Cloudflare AI Gateway / Workers AI (no Vercel required)
EVE_LLM_BACKEND=cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AIG_GATEWAY_ID=default
# REST AI Gateway path uses @cf/... ; /compat URL uses workers-ai/@cf/...
EVE_MODEL=@cf/zai-org/glm-5.2
# Optional override:
# CF_AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/compat
# EVE_MODEL=workers-ai/@cf/zai-org/glm-5.2

# Optional: Vercel AI Gateway instead of Cloudflare
# EVE_LLM_BACKEND=vercel-gateway
# AI_GATEWAY_API_KEY=
# EVE_MODEL=zai/glm-5.2

# Browser → Vite proxy → Eve HTTP API
VITE_EVE_BASE_URL=/eve
VITE_EVE_PROXY_TARGET=http://127.0.0.1:3000


# Optional branding for OpenRouter rankings / Referer
VITE_APP_URL=http://127.0.0.1:5173
VITE_APP_NAME=AgentChicago17B

# Force provider when model slug is ambiguous: cloudflare | openrouter | nvidia
# VITE_LLM_PROVIDER=openrouter

# --- Cloudflare Workers AI (OpenAI-compatible) ---
# .../accounts/<ACCOUNT_ID>/ai/v1
VITE_CF_API_KEY=
VITE_CF_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Default model — CF GLM for commercial-grade reasoned briefs
VITE_LLM_MODEL=@cf/zai-org/glm-5.2

# --- OpenRouter (optional) ---
# https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Example defaults once OpenRouter is your primary provider:
# VITE_LLM_MODEL=anthropic/claude-sonnet-4
# VITE_LLM_PROVIDER=openrouter

# --- NVIDIA Build (optional second provider) ---
# https://build.nvidia.com/settings/api-keys
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional later: Tavily for live web source gathering
VITE_TAVILY_API_KEY=

# Optional: Cloudflare Whisper for mic → text (speech-to-text)
# Default: @cf/openai/whisper-large-v3-turbo
# VITE_CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
