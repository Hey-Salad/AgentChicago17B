# Cloudflare Workers AI (OpenAI-compatible)
# .../accounts/<ACCOUNT_ID>/ai/v1
VITE_CF_API_KEY=
VITE_CF_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# Default model — CF GLM for commercial-grade reasoned briefs
VITE_LLM_MODEL=@cf/zai-org/glm-5.2

# NVIDIA Build (optional second provider)
# https://build.nvidia.com/settings/api-keys
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional later: Tavily for live web source gathering
VITE_TAVILY_API_KEY=

# Optional: Cloudflare Whisper for mic → text (speech-to-text)
# Default: @cf/openai/whisper-large-v3-turbo
# VITE_CF_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
